{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dsh-embed",
  "description": "Harness embed opens target=_blank account links via shell.open.",
  "windows": [
    "main"
  ],
  "webviews": [
    "dsh-embed"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*",
      "http://localhost:*/*"
    ]
  },
  "permissions": [
    "shell:allow-open"
  ]
}
